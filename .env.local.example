# 部署仅需这两项；其余在首次 /setup 中配置并加密写入数据库。

DATABASE_URL="postgresql://pagescms:pagescms@localhost:5432/pagescms"
CRYPTO_KEY="任意字符串或-base64-16-24-32字节密钥"

# 可选：本地仓库开发
# LOCAL_REPO_MODE=true
# LOCAL_DEV_BYPASS_AUTH=true
# LOCAL_REPO_ALLOW_ANY_USER=false
# 生产环境若确需非管理员访问本地仓，还需显式开启下一行（单用户主机专用）
# LOCAL_REPO_ALLOW_ANY_USER_IN_PRODUCTION=false
# 可选：限制可挂载的工作区根目录（逗号分隔绝对路径）；未设则不限制目录范围
# LOCAL_REPO_ALLOWED_ROOTS=
# LOCAL_REPO_PATH=
# LOCAL_REPO_OWNER=local
# LOCAL_REPO_NAME=hugo-blog
# LOCAL_REPO_BRANCH=main

# 可选：进阶调优（通常不需要）
# STAGED_REPO_OWNER=
# STAGED_REPO_NAME=
# GITHUB_TOKEN=
# LOCAL_REPO_GITHUB_TOKEN=
# POSTGRES_MAX_CONNECTIONS=10
